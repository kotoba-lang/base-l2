{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
              ;; Advanced from b47b064: that pin predates json's kwargs fix (d5137c7),
       ;; so `(read-str s :key-fn keyword)` threw ArityException before a single
       ;; test could run. The fix was on json's main and could not reach here.
       io.github.kotoba-lang/json {:git/sha "0945bf526bcb077f891c4aadb20d607b74da07cd"}
        io.github.kotoba-lang/eth-crypto
        {:git/url "https://github.com/kotoba-lang/eth-crypto"
         :git/sha "2b0e56d28262eb1b513cee6c822a55714303f39a"}}
 :aliases
 {;; org.babashka/http-client is a TEST-only dep (the reference
  ;; kotoba.lang.base-l2.rpc/ITransport adapter under test/, exercised
  ;; against l2_test.clj's mock JSON-RPC HTTP server) -- the pure
  ;; src/ core carries zero HTTP-client dep, matching kotoba-lang/ipfs's
  ;; "zero vendor/SDK deps in the core" rule.
  :test {:extra-paths ["test" "test/resources"]
         :extra-deps {org.babashka/http-client {:mvn/version "0.4.22"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
